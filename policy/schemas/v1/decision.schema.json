{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operation-firewall:schema:v1:decision",
  "title": "Operation Firewall Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "operation_id", "operation_digest", "evaluated_at", "outcome", "policy_snapshot_digest", "determining_rules", "risk_categories", "rationale", "safer_alternatives", "reevaluate_after", "approval_requirement"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "decision_id": { "$ref": "#/$defs/uuid" },
    "operation_id": { "$ref": "#/$defs/uuid" },
    "operation_digest": { "$ref": "#/$defs/digest" },
    "evaluated_at": { "$ref": "#/$defs/dateTime" },
    "outcome": { "enum": ["allow", "ask", "deny", "indeterminate"] },
    "policy_snapshot_digest": { "$ref": "#/$defs/digest" },
    "determining_rules": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "bundle_id", "bundle_version", "rule_id", "effect"],
        "properties": {
          "layer": { "enum": ["builtin", "organization", "user", "repository"] },
          "bundle_id": { "$ref": "#/$defs/id" },
          "bundle_version": { "$ref": "#/$defs/version" },
          "rule_id": { "$ref": "#/$defs/id" },
          "effect": { "enum": ["allow", "ask", "deny"] }
        }
      }
    },
    "risk_categories": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/namespacedName" } },
    "rationale": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "safer_alternatives": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "reevaluate_after": { "type": ["string", "null"], "format": "date-time", "maxLength": 35 },
    "approval_requirement": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["approval_class", "expires_in_seconds", "max_uses", "distinct_approver_required", "bound_fields"],
          "properties": {
            "approval_class": { "enum": ["local_human", "organization_approver", "break_glass"] },
            "expires_in_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
            "max_uses": { "const": 1 },
            "distinct_approver_required": { "type": "boolean" },
            "bound_fields": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["operation_digest", "targets", "actor", "session", "environment", "policy_snapshot_digest", "expiry", "use_count"] },
              "allOf": [
                { "contains": { "const": "operation_digest" } },
                { "contains": { "const": "targets" } },
                { "contains": { "const": "actor" } },
                { "contains": { "const": "session" } },
                { "contains": { "const": "environment" } },
                { "contains": { "const": "policy_snapshot_digest" } },
                { "contains": { "const": "expiry" } },
                { "contains": { "const": "use_count" } }
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "ask" } }, "required": ["outcome"] },
      "then": { "properties": { "approval_requirement": { "type": "object" } } },
      "else": { "properties": { "approval_requirement": { "type": "null" } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9]+(\\.[0-9]+){0,2}([+-][0-9A-Za-z.-]+)?$" },
    "namespacedName": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "dateTime": { "type": "string", "format": "date-time", "maxLength": 35 },
    "digest": { "type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }
  }
}
