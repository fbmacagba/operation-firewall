DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CHAINED="$DIR/pre-commit.aramid-chained"
if [ -f "$CHAINED" ]; then
    "$CHAINED" "$@" || exit $?
fi

INTERP="/c/Python314/python.exe"
if [ -x "$INTERP" ]; then
